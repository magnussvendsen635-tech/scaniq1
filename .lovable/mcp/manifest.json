{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://uqnwhypjrisbfkouwcge.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "scaniq",
      "version": "0.1.0",
      "title": "ScanIQ"
    },
    "tools": [
      {
        "name": "get_daily_summary",
        "title": "Get daily summary",
        "description": "Summarize the signed-in user's nutrition for one day: total calories, macros, water intake and workouts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Day in YYYY-MM-DD format. Defaults to today (UTC)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_meals",
        "title": "List meals",
        "description": "List the signed-in user's logged meals with calories and macros, optionally filtered by date range (YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date, YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date, YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 50, max 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_meal",
        "title": "Log a meal",
        "description": "Log a meal with calories and macros for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Meal name, e.g. 'Chicken salad'."
            },
            "calories": {
              "type": "number",
              "description": "Total calories (kcal) for the portion."
            },
            "protein": {
              "type": "number",
              "description": "Protein in grams."
            },
            "carbs": {
              "type": "number",
              "description": "Carbohydrates in grams."
            },
            "fat": {
              "type": "number",
              "description": "Fat in grams."
            },
            "category": {
              "type": "string",
              "description": "Meal category, e.g. breakfast, lunch, dinner, snack."
            },
            "eaten_at": {
              "type": "string",
              "description": "ISO timestamp of when it was eaten. Defaults to now."
            }
          },
          "required": [
            "name",
            "calories"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_weight",
        "title": "Log weight",
        "description": "Record a body-weight entry (kg) for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": "number",
              "description": "Body weight in kilograms."
            },
            "logged_at": {
              "type": "string",
              "description": "ISO timestamp. Defaults to now."
            }
          },
          "required": [
            "weight_kg"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_weights",
        "title": "List weight entries",
        "description": "List the signed-in user's recorded body-weight entries, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 30, max 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
